<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- The WebView Video Player (Base Layer) -->
    <WebView
        android:id="@+id/youtube_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000" />

    <!-- Overlay Container (UI Layer) -->
    <FrameLayout
        android:id="@+id/overlay_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:focusable="true"
        android:clickable="true"
        tools:visibility="visible">

        <!-- Top Gradient (for better visibility of top icons) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="top"
            android:background="@drawable/player_controls_top_gradient" />

        <!-- Top Controls (Close, Title, Autoplay, Cast, CC, Settings) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageButton
                android:id="@+id/btn_exit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_baseline_keyboard_arrow_down_24"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/video_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                tools:text="Video Title Goes Here..." />

            <ImageButton
                android:id="@+id/btn_autoplay"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Autoplay"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_baseline_play_arrow_24"
                app:tint="#FFFFFF"
                android:visibility="gone" /> <!-- Hidden by default, standard YT UI -->

            <ImageButton
                android:id="@+id/btn_captions"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Captions"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_baseline_subtitles_24"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_baseline_color_lens_24"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Center Controls (Rewind, Play/Pause, Forward) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_rewind"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="40dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Rewind 10s"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_baseline_replay_24"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Play/Pause"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_baseline_pause_24"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btn_forward"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="40dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Forward 10s"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_baseline_fast_forward_24"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Bottom Controls (Time, Seekbar, Fullscreen) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/player_controls_bottom_gradient"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Time and specific buttons -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/text_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_separator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="4dp"
                    android:layout_toEndOf="@id/text_current_time"
                    android:text="/"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/text_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="4dp"
                    android:layout_toEndOf="@id/text_separator"
                    android:text="0:00"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btn_scale"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle Fullscreen"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_baseline_aspect_ratio_24"
                    app:tint="#FFFFFF" />

            </RelativeLayout>

            <!-- YouTube Red Seekbar -->
            <SeekBar
                android:id="@+id/player_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:max="100"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:progress="0"
                android:progressDrawable="@drawable/youtube_seekbar_progress"
                android:thumb="@drawable/youtube_seekbar_thumb" />

        </LinearLayout>
    </FrameLayout>
    
    <!-- Loading overlay when initializing/loading -->
    <ProgressBar
        android:id="@+id/loading_indicator"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FF0000"
        android:visibility="gone" />

</FrameLayout>
